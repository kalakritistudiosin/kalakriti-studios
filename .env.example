# ============================================================
# Kalakriti Studios — environment variables (copy to .env)
# Set the SAME variables in Netlify: Site configuration → Environment variables
# Never commit real values.
# ============================================================

# --- PostgreSQL (Neon) ---
# Pooled connection string (host contains "-pooler") — used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection string (same host WITHOUT "-pooler") — used only for migrations
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Auth.js (NextAuth v5) — Google sign-in only ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST=true
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorised redirect URI: https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-xxxxxxxx"

# The Google account with this email becomes ADMIN (no admin password exists)
ADMIN_EMAIL="owner@example.com"

# Optional: public site URL for canonical/OG/sitemap (Netlify also provides URL automatically)
SITE_URL=""

# --- Cloudinary (console.cloudinary.com → Settings → API Keys) ---
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Public site origin used by Auth.js for OAuth callbacks (MUST match the Google redirect URI origin)
# Netlify: https://kalakritistudios.netlify.app (or your custom domain)
AUTH_URL="https://YOUR-SITE.netlify.app"
